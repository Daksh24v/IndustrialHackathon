# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# FINNI's voice (the mic): the ElevenLabs API key, the one that starts with sk_
ELEVENLABS_API_KEY=
# Optional: a shared link (scripts/share.sh) then needs ?code=<this> to start conversations
FINNI_ACCESS_CODE=
# Optional, not here but in app/.env (then npm run build): the Google 3D opening of the venue, see app/README.md
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# Optional: email the maintenance team when someone reports something broken (else it's in the on-screen inbox).
# A Resend API key (resend.com) and the address that gets the reports; MAIL_FROM needs a domain verified there.
RESEND_API_KEY=
MAINTENANCE_EMAIL=
# MAIL_FROM=FINNI <finni@your-domain.com>
